{
	"schema": "deadload.routine/1",
	"name": "Lower back relief",
	"goal": "back relief",
	"description": "Gentle decompression and light posterior-chain work for a stiff lower back. Stop at tension, never at pain.",
	"tags": ["evening", "back", "recovery"],
	"blocks": [
		{
			"label": "Decompress",
			"items": [
				{ "exercise": "hug_knees_to_chest", "sets": 1, "duration_seconds": 60, "rest_seconds": 0 },
				{ "exercise": "knee_across_the_body", "sets": 1, "duration_seconds": 45, "per_side": true, "rest_seconds": 0 },
				{ "exercise": "cat_stretch", "sets": 1, "reps": 12, "rest_seconds": 0, "notes": "Small range, slow tempo." },
				{ "exercise": "childs_pose", "sets": 1, "duration_seconds": 60, "rest_seconds": 0 }
			]
		},
		{
			"label": "Support",
			"items": [
				{ "exercise": "dead_bug", "sets": 2, "reps": 8, "per_side": true, "rest_seconds": 30, "notes": "Keep the lower back flat against the floor." },
				{ "exercise": "butt_lift_bridge", "sets": 2, "reps": 12, "rest_seconds": 30 },
				{ "exercise": "side_bridge", "sets": 2, "duration_seconds": 20, "per_side": true, "rest_seconds": 30 },
				{ "exercise": "superman", "sets": 2, "duration_seconds": 15, "rest_seconds": 30 }
			]
		},
		{
			"label": "Finish",
			"items": [
				{ "exercise": "seated_floor_hamstring_stretch", "sets": 1, "duration_seconds": 45, "rest_seconds": 0 },
				{ "exercise": "spinal_stretch", "sets": 1, "duration_seconds": 45, "rest_seconds": 0 }
			]
		}
	]
}
