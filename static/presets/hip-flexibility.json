{
	"schema": "deadload.routine/1",
	"name": "Morning hip mobility",
	"goal": "hip flexibility",
	"description": "A 15 minute floor sequence for desk-related hip tightness. Move slowly and follow the breath.",
	"tags": ["morning", "mobility", "hips"],
	"blocks": [
		{
			"label": "Warm-up",
			"items": [
				{ "exercise": "cat_stretch", "sets": 1, "reps": 10, "rest_seconds": 0, "notes": "Move with the breath, not through it." },
				{ "exercise": "pelvic_tilt_into_bridge", "sets": 1, "reps": 10, "rest_seconds": 0 },
				{ "exercise": "hip_circles_prone", "sets": 1, "duration_seconds": 30, "per_side": true, "rest_seconds": 0 }
			]
		},
		{
			"label": "Main",
			"items": [
				{ "exercise": "worlds_greatest_stretch", "sets": 2, "duration_seconds": 45, "per_side": true, "rest_seconds": 15 },
				{ "exercise": "kneeling_hip_flexor", "sets": 2, "duration_seconds": 45, "per_side": true, "rest_seconds": 15, "notes": "Tuck the pelvis before leaning in." },
				{ "exercise": "90_90_hamstring", "sets": 2, "duration_seconds": 40, "per_side": true, "rest_seconds": 10 },
				{ "exercise": "ankle_on_the_knee", "sets": 2, "duration_seconds": 40, "per_side": true, "rest_seconds": 10 },
				{ "exercise": "the_straddle", "sets": 2, "duration_seconds": 45, "rest_seconds": 15 }
			]
		},
		{
			"label": "Cooldown",
			"items": [
				{ "exercise": "childs_pose", "sets": 1, "duration_seconds": 60, "rest_seconds": 0 },
				{ "exercise": "hug_knees_to_chest", "sets": 1, "duration_seconds": 45, "rest_seconds": 0 }
			]
		}
	]
}
