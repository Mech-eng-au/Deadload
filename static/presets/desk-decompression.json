{
	"schema": "deadload.routine/1",
	"name": "Desk decompression",
	"goal": "posture relief",
	"description": "Five minutes for a neck, chest and wrists that have been at a keyboard all day. Can be done standing.",
	"tags": ["short", "posture", "desk"],
	"blocks": [
		{
			"items": [
				{ "exercise": "chin_to_chest_stretch", "sets": 1, "duration_seconds": 30, "rest_seconds": 0 },
